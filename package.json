{
  "name": "feudo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r --if-present run test",
    "test:integration": "pnpm --filter @feudo/web run test:integration",
    "build": "pnpm -r run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md,css,yml,yaml}": "prettier --write",
    "apps/web/src/**/*.{ts,tsx}": "pnpm --filter @feudo/web exec eslint --max-warnings=0",
    "packages/core/src/**/*.ts": "pnpm --filter @feudo/core exec eslint --max-warnings=0"
  }
}
